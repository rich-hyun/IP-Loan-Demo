[Unit]
Description=IP-loan API (Flask + gunicorn)
After=network-online.target remote-fs.target
Wants=network-online.target

[Service]
Type=simple
User=sai
WorkingDirectory=/mnt/nas4/kjh/IP-Loan-Demo/server
Environment="IPLOAN_DB_PATH=/mnt/nas4/kjh/IP-Loan-Demo/server/iploan.db"
EnvironmentFile=-/mnt/nas4/kjh/IP-Loan-Demo/server/.env
ExecStart=/mnt/nas4/kjh/IP-Loan-Demo/server/venv/bin/gunicorn -w 2 --threads 4 --timeout 120 -b 127.0.0.1:58080 app:app
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
