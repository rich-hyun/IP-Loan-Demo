# Public settings only. This file is a reference, not auto-loaded.
PORT=5001
IPLOAN_RPC_URL=https://block.mustree.kr
IPLOAN_CHAIN_ID=7601
# v2 Manager (contractVersion() == 2) deployed on Mustsem; see blockchain/deployments/mustsem.json.
IPLOAN_MANAGER_ADDRESS=0x6D1004CB292e3ec45A4c4A0834C0eedAAbe16E38
IPLOAN_ZERO_GAS_PRICE=0
# Optional preferred registered participants; blank selects randomly from current role holders.
# Evaluator is assigned at application, bank/reviewer when a passing evaluation is prepared.
IPLOAN_ASSIGNMENT_EVALUATOR=
IPLOAN_ASSIGNMENT_BANK=
# NO wallet private keys on the server.

# Patent report service: server/patent_api.py reads these from server/.env.
IPLOAN_PATENT_API_URL=http://203.252.147.200:20024
IPLOAN_PATENT_API_TOKEN=replace_with_provided_token
